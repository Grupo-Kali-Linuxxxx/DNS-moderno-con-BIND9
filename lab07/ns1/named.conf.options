// /etc/bind/named.conf.options — ns1: servidor AUTORITATIVO (no resuelve nombres ajenos)
options {
    directory "/var/cache/bind";

    listen-on    { any; };
    listen-on-v6 { none; };

    recursion no;                 // servidor autoritativo puro, no resuelve nombres ajenos
    allow-query     { any; };     // cualquiera puede preguntar por NUESTRAS zonas
    allow-transfer  { none; };    // por defecto nadie copia zonas (se abre por zona y con clave)

    version "no disponible";      // ocultar la versión de BIND
    dnssec-validation auto;
    minimal-responses yes;
};
